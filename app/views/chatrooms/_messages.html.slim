.messages data-chatroom-subscription-target="scrollContent"
  .messages__container data-chatroom-subscription-target="latestMessages"
    - chatroom.messages.each do |message|
      = render partial: 'messages/message', locals: { message: message }

  .messages__form.mt-auto.p-3
    - @message = Message.new
    = simple_form_for [chatroom, @message], html: { class: "d-flex" } do |f|
      = f.input :content,
        label: false,
        placeholder: "Type your message",
        input_html: { class: "messages__input", data: { chatroom_subscription_target: "chatField" } },
        wrapper_html: { class: "flex-grow-1" }

      = f.submit "Send", class: "messages__submit btn btn-primary mb-3 ms-2"